# /etc/portage/env/clang-lto.env
# Clang + ThinLTO para pacotes onde o ganho de performance é real
# ThinLTO: versão paralela do LTO — muito mais rápida que o LTO clássico
# Aplicar seletivamente; globalmente causa problemas em vários pacotes

CFLAGS="-march=znver2 -O2 -pipe -flto=thin"
CXXFLAGS="${CFLAGS}"
LDFLAGS="-fuse-ld=lld -flto=thin"
