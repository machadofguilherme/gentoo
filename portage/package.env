# /etc/portage/package.env

# ── Fallback GCC obrigatório ──────────────────────────────────────────────────

# glibc tem código dependente de comportamento interno do GCC
# tecnicamente melhorou com Clang em versões recentes, mas ainda é terreno minado
sys-libs/glibc              gcc.env

# trivial — GCC se compila com GCC
sys-devel/gcc               gcc.env

# libtool gerado por autoconf antigo, sensível ao compilador
sys-devel/libtool           gcc.env

# ── LTO seletivo ─────────────────────────────────────────────────────────────

# Mesa: ganho direto em fps em jogos via radeonsi/radv mais otimizado
media-libs/mesa             clang-lto.env

# LLVM: compila a si mesmo melhor com LTO; melhora todo o toolchain subsequente
sys-devel/llvm              clang-lto.env

# zstd: compressão usada pelo BTRFS, Portage, Zram — ciclos de CPU importam
app-arch/zstd               clang-lto.env

# SDL2: camada de baixo nível dos jogos — cada % de latência conta
media-libs/libsdl2          clang-lto.env
