# /etc/portage/package.use/10-multimedia

# Mesa — RADV (Vulkan AMD), VA-API (decode HW), LLVM (backend radeonsi)
# vdpau: redundante com VA-API em AMD, mas algumas libs de vídeo ainda pedem
media-libs/mesa          vulkan vaapi vdpau llvm gles2

# libva — VA-API sem X11 (drm = acesso direto ao GPU via DRM/KMS)
media-libs/libva         drm

# FFmpeg — decode/encode por hardware via VA-API
# encode: necessário para OBS, gravação de tela, etc.
media-video/ffmpeg       vaapi encode -vdpau
